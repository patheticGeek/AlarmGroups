<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlarmGroups" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- The launcher icon shows two clocks (a group); on the splash a single clock reads better. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
